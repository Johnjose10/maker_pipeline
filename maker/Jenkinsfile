
pipeline {
    agent any

    environment {
        // Docker configuration
        DOCKER_CREDENTIALS_ID = 'docker-cred'
        DOCKER_IMAGE          = 'docker777john/maker'

        // SonarQube configuration
        SONAR_SERVER_NAME     = 'sonarqube-env'
        SONAR_SCANNER_TOOL    = 'sonar-scanner'

        // GitHub configuration
        GIT_CREDENTIALS_ID    = 'github-cred'
        MANIFEST_REPO         = 'https://github.com/Johnjose10/maker_pipeline.git'
        MANIFEST_BRANCH       = 'main'
    }

    stages {

        // 1. Checkout Source Code
        stage('Checkout Source Code') {
            steps {
                checkout scm
                echo 'Source code checked out successfully'
            }
        }

        // 2. SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool "${SONAR_SCANNER_TOOL}"

                    withSonarQubeEnv("${SONAR_SERVER_NAME}") {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=maker-key \
                            -Dsonar.projectName=maker-project-test \
                            -Dsonar.sources=. \
                            -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        // 3. Build and Push Docker Image
        stage('Build & Push Docker Image') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_CREDENTIALS_ID}",
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "$DOCKER_PASS" | docker login \
                            -u "$DOCKER_USER" --password-stdin

                            docker build \
                            -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                            -t ${DOCKER_IMAGE}:latest \
                            -f maker/Dockerfile maker

                            docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                            docker push ${DOCKER_IMAGE}:latest

                            docker logout
                        '''
                    }
                }
            }
        }

        // 4. Update Kubernetes Manifest in GitHub
        stage('Update Manifest Repo') {
            steps {
                dir('manifest-workspace') {

                    // Checkout manifest repository
                    git branch: "${MANIFEST_BRANCH}",
                        credentialsId: "${GIT_CREDENTIALS_ID}",
                        url: "${MANIFEST_REPO}"

                    withCredentials([
                        usernamePassword(
                            credentialsId: "${GIT_CREDENTIALS_ID}",
                            usernameVariable: 'GH_USER',
                            passwordVariable: 'GH_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -e

                            # Create temporary GitHub authentication script
                            ASKPASS=$(mktemp)

                            trap 'rm -f "$ASKPASS"' EXIT

                            cat > "$ASKPASS" <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) echo "$GH_USER" ;;
    *Password*) echo "$GH_TOKEN" ;;
esac
EOF

                            chmod 700 "$ASKPASS"

                            export GIT_ASKPASS="$ASKPASS"
                            export GIT_TERMINAL_PROMPT=0

                            # Configure Git
                            git remote set-url origin "$MANIFEST_REPO"

                            git config user.name "Johnjose10"
                            git config user.email "jhon123jose@gmail.com"

                            # Pull latest changes
                            git pull --rebase origin "$MANIFEST_BRANCH"

                            # Update Docker image tag in deployment.yaml
                            sed -i '/name: maker/{n;s|image:.*|image: docker777john/maker:'"${BUILD_NUMBER}"'|}' \
                            maker/manifests/deployment.yaml

                            # Add updated manifest
                            git add maker/manifests/deployment.yaml

                            # Commit and push changes
                            if ! git diff --cached --quiet; then

                                git commit -m "Update maker image to ${BUILD_NUMBER} [skip ci]"

                                git push origin "$MANIFEST_BRANCH"

                                echo "Manifest successfully pushed to GitHub"

                            else
                                echo "No manifest changes to commit"
                            fi
                        '''
                    }
                }
            }
        }
    }

    // 5. Post Build Actions
    post {
        success {
            echo 'SUCCESS: Pipeline executed successfully!'
            echo 'Docker image pushed and Kubernetes manifest updated.'
        }

        failure {
            echo 'FAILURE: Pipeline failed. Please check the stage logs.'
        }

        always {
            echo 'Jenkins pipeline execution completed.'
        }
    }
}
